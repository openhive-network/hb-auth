    "test:offline": "unset CI && playwright test --workers 1 --max-failures 1 --project=hbauth_testsuite --grep \"HB Auth Offline Client\"",
    "prebuild": "pnpm run husky && pnpm run lint",
    "husky": "husky ./.husky"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/hb-auth.d.ts",
        "default": "./dist/hb-auth.js"
      }
    },
    "./worker.js": {
      "require": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
